{
    "name": "innoge/laravel-speculation-rules-api",
    "description": "A Laravel package as streamlined solution to utilize the speculation rules api.",
    "keywords": [
        "InnoGE",
        "laravel"
    ],
    "homepage": "https://github.com/innoge/laravel-speculation-rules-api",
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Seuffer",
            "email": "authanram@users.noreply.github.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/contracts": "^9.38|^10.0|^11.0|^12.0",
        "spatie/laravel-package-tools": "^1.14.0"
    },
    "require-dev": {
        "composer/semver": "^3.4",
        "laravel/pint": "^1.0",
        "nunomaduro/larastan": "^2.0.1|^3.0",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0",
        "phpstan/extension-installer": "^1.1",
        "spatie/laravel-ray": "^1.26"
    },
    "autoload": {
        "psr-4": {
            "InnoGE\\LaravelSpeculationRulesApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InnoGE\\LaravelSpeculationRulesApi\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": [
            "@composer run prepare",
            "@php vendor/bin/testbench workbench:build --ansi"
        ],
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "@composer run build",
            "@php vendor/bin/testbench serve"
        ],
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "InnoGE\\LaravelSpeculationRulesApi\\LaravelSpeculationRulesApiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
